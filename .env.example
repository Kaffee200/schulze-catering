# Kopieren nach .env.local und ausfüllen
# Empfänger der Anfragen
MAIL_TO=email@catering-schulze.de
MAIL_FROM="Webseite Schulze Catering <no-reply@catering-schulze.de>"

# SMTP-Zugang (ohne diese Werte werden Anfragen nur in der Server-Konsole ausgegeben)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
